# fetch-pr-skill 配置模板
#
# 使用方法:
#   1. 复制本文件到 ~/.fetch-pr-skill/obs-cred.conf
#      mkdir -p ~/.fetch-pr-skill && cp config/obs-cred.conf.example ~/.fetch-pr-skill/obs-cred.conf
#   2. 填入真实的华为云 OBS 凭证
#   3. 权限建议: chmod 600 ~/.fetch-pr-skill/obs-cred.conf

# 华为云 OBS AK/SK（用于上传评测报告）
OBS_AK=your-huawei-obs-access-key
OBS_SK=your-huawei-obs-secret-key

# OBS 桶与 CDN 域名（评测报告上传目标）
OBS_BUCKET=your-obs-bucket
OBS_CDN_DOMAIN=your-cdn-domain.example.com
OBS_REGION=cn-north-4

# 默认共建仓库（触发词充足度检索库），格式 owner/repo
DEFAULT_REPO=developer-skill/huaweicloud-skills-dev
