#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
skill-quality — AI Skill 执行质量上报 CLI (零第三方依赖)

通过 APIG 公网接口上报，IAM 认证（AK/SK 自动从环境变量加载）。
后端自动从 Token 解析上报人信息（账号名/用户ID/域名）。

用法:
    skill-quality report --skill-name "code-review" --status success
    skill-quality report --skill-name "rds-list" --status sys_fail --error-code N01 --cost-ms 5000
    skill-quality check
    skill-quality wrap --skill-name "my-skill" -- python3 my_skill.py

配置(环境变量):
    SKILL_QUALITY_ENDPOINT   上报地址(APIG公网)
    SKILL_QUALITY_REGION     华为云区域(默认 cn-north-4)
    SKILL_QUALITY_AK/SK      AK/SK(或从 HUAWEI_CLOUD_SDK_AK/SK / HW_ACCESS_KEY/SECRET_KEY 加载)
    SKILL_QUALITY_TIMEOUT    HTTP超时秒数(默认 3)
    SKILL_QUALITY_DISABLE    设 1 禁用上报
"""

import argparse
import json
import os
import re
import subprocess
import sys
import ssl
import time
import traceback
import uuid
import urllib.request
import urllib.error
from datetime import datetime, timezone

__version__ = "1.1.0"

# ==================== 配置 ====================

ENDPOINT = os.environ.get(
    "SKILL_QUALITY_ENDPOINT",
    "https://skillsapi.developer.myhuaweicloud.com/api/quality/report"
)
REGION = os.environ.get("SKILL_QUALITY_REGION", "cn-north-4")
HTTP_TIMEOUT = float(os.environ.get("SKILL_QUALITY_TIMEOUT", "3"))
DISABLED = os.environ.get("SKILL_QUALITY_DISABLE", "0") == "1"
INSECURE = os.environ.get("SKILL_QUALITY_INSECURE", "0") == "1"

# ==================== SSL Context ====================

def _ssl_context():
    """INSECURE=1 时跳过证书验证(自定义域名未配证书时使用)"""
    if INSECURE:
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        return ctx
    return None

# ==================== 脱敏 ====================

_MASK_PATTERNS = [
    (re.compile(r"1[3-9]\d{9}"), "<phone>"),
    (re.compile(r"(?i)(secret|password|passwd|token|api[_-]?key|access[_-]?key|ak|sk)['\"]?\s*[:=]\s*['\"]?[A-Za-z0-9_\-\.]{6,}"), rF"\1=<masked>"),
    (re.compile(r"(?i)(sk-[A-Za-z0-9]{8,}|AKIA[A-Z0-9]{16}|mul_[A-Za-z0-9]{20,})"), "<secret>"),
    (re.compile(r"(?i)\b[A-Z0>9]{20,}\b"), "<secret>"),  # 华为AK等长密钥
]

def mask_text(text):
    """对入参/输出做脱敏(手机号/密钥/token/AK-SK)"""
    if text is None:
        return ""
    s = str(text)
    for pat, repl in _MASK_PATTERNS:
        s = pat.sub(repl, s)
    return s

# ==================== 错误码推断 ====================

# 按stderr输出关键词推断标准错误码(U/C/N/B/P四级)
_NETWORK_HINTS = ("timeout", "timed out", "connection", "网络", "connect", "refused", "reset")
_RESP_HINTS = ("5xx", "503", "502", "429", "熔断", "限流", "circuit", "rate limit")
_CONFIG_HINTS = ("config", "配置", "secret", "key", "credential", "env", "环境变量", "not configured")
_PARAM_HINTS = ("missing", "required", "无效", "非法", "缺失", "invalid", "not found", "不存在", "为空")
_TIMEOUT_HINTS = ("timeout", "超时", "timed out")

def infer_error_code(stderr_output, is_timeout=False):
    """从子进程stderr推断标准错误码(尽力而为, 调用方可显式指定)。
    
    N01 下游接口超时 / N02 网络连接失败 / N03 下游熔断限流
    C01 配置缺失 / U02 入参格式非法 / P03 调度超时
    B01 代码缺陷(兜底)
    """
    msg = (stderr_output or "").lower()
    if is_timeout or any(h in msg for h in _TIMEOUT_HINTS):
        return "N01" if any(h in msg for h in _NETWORK_HINTS) else "P03"
    if any(h in msg for h in _NETWORK_HINTS):
        return "N02"
    if any(h in msg for h in _RESP_HINTS):
        return "N03"
    if any(h in msg for h in _CONFIG_HINTS):
        return "C01"
    if any(h in msg for h in _PARAM_HINTS):
        return "U02"
    return "B01"

def infer_status_from_error_code(error_code):
    """根据 error_code 前缀推断 status: C/N/B/P → sys_fail, U → biz_fail"""
    if not error_code:
        return "biz_fail"
    prefix = error_code[0].upper()
    if prefix in ("C", "N", "B", "P"):
        return "sys_fail"
    return "biz_fail"

# ==================== Agent 自动识别 ====================

def detect_agent():
    """多级检测: SKILL_QUALITY_AGENT > HERMES_AGENT_NAME > AGENT_NAME > 检测HERMES环境变量 > unknown"""
    return (
        os.environ.get("SKILL_QUALITY_AGENT")
        or os.environ.get("HERMES_AGENT_NAME")
        or os.environ.get("AGENT_NAME")
        or ("hermes" if any(k.startswith("HERMES") for k in os.environ) else "unknown")
    )

# ==================== AK/SK 加载 ====================

def load_ak_sk():
    """按优先级从环境变量加载 AK/SK"""
    ak = (
        os.environ.get("SKILL_QUALITY_AK")
        or os.environ.get("HUAWEI_CLOUD_SDK_AK")
        or os.environ.get("HW_ACCESS_KEY")
    )
    sk = (
        os.environ.get("SKILL_QUALITY_SK")
        or os.environ.get("HUAWEI_CLOUD_SDK_SK")
        or os.environ.get("HW_SECRET_KEY")
    )
    return ak, sk

# ==================== IAM Token ====================

def get_iam_token(ak, sk, region):
    """用 AK/SK 获取 IAM Token"""
    iam_url = f"https://iam.{region}.myhuaweicloud.com/v3/auth/tokens"
    body = json.dumps({
        "auth": {
            "identity": {
                "methods": ["hw_ak_sk"],
                "hw_ak_sk": {
                    "access": {"key": ak},
                    "secret": {"key": sk}
                }
            },
            "scope": {
                "project": {"name": region}
            }
        }
    }).encode("utf-8")

    req = urllib.request.Request(
        iam_url, data=body, method="POST",
        headers={"Content-Type": "application/json"}
    )
    try:
        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT + 5, context=_ssl_context()) as resp:
            if resp.status != 201:
                raise RuntimeError(f"IAM Token 获取失败: HTTP {resp.status}")
            token = resp.headers.get("X-Subject-Token", "")
            if not token:
                raise RuntimeError("IAM 响应中无 X-Subject-Token")
            return token
    except urllib.error.URLError as e:
        raise RuntimeError(f"IAM Token 获取失败: {e}")

# ==================== 上报 ====================

def _now_iso():
    return datetime.now(timezone.utc).astimezone().strftime("%Y-%m-%dT%H:%M:%S")

def _new_trace_id():
    return uuid.uuid4().hex

def _post_with_token(payload, token):
    """带 IAM Token 上报"""
    body = json.dumps(payload, ensure_ascii=False, default=str).encode("utf-8")
    req = urllib.request.Request(
        ENDPOINT, data=body, method="POST",
        headers={
            "Content-Type": "application/json",
            "X-Auth-Token": token,
        }
    )
    try:
        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT, context=_ssl_context()) as resp:
            resp_body = resp.read().decode("utf-8")
            return resp.status == 200, resp_body
    except urllib.error.HTTPError as e:
        resp_body = e.read().decode("utf-8") if e.fp else ""
        return False, f"HTTP {e.code}: {resp_body}"
    except urllib.error.URLError as e:
        return False, str(e)

def do_report(args):
    """执行上报"""
    if DISABLED:
        print("SKILL_QUALITY_DISABLE=1, 上报已禁用")
        return 0

    ak, sk = load_ak_sk()
    if not ak or not sk:
        print("错误: 未找到 AK/SK，请设置环境变量 SKILL_QUALITY_AK/SK 或 HUAWEI_CLOUD_SDK_AK/SK", file=sys.stderr)
        return 1

    # 获取 IAM Token
    try:
        token = get_iam_token(ak, sk, REGION)
    except RuntimeError as e:
        print(f"错误: {e}", file=sys.stderr)
        return 1

    # 构造上报数据
    trace_id = _new_trace_id()
    start_time = getattr(args, "start_time", None) or _now_iso()
    end_time = getattr(args, "end_time", None) or _now_iso()

    # 脱敏
    input_param = getattr(args, "input_param", None)
    output_result = getattr(args, "output_result", None)
    if input_param is not None:
        input_param = mask_text(input_param)[:6000]
    if output_result is not None:
        output_result = mask_text(output_result)[:6000]

    payload = {
        "trace_id": trace_id,
        "skill_name": args.skill_name,
        "skill_id": getattr(args, "skill_id", None) or os.environ.get("SKILL_QUALITY_ID", ""),
        "skill_version": getattr(args, "skill_version", None) or os.environ.get("SKILL_QUALITY_VERSION", ""),
        "status": args.status,
        "error_code": getattr(args, "error_code", None),
        "error_msg": getattr(args, "error_msg", None),
        "cost_ms": getattr(args, "cost_ms", None),
        "input_param": input_param,
        "output_result": output_result,
        "full_stack": getattr(args, "full_stack", None),
        "retry_times": getattr(args, "retry_times", None),
        "is_timeout": 1 if getattr(args, "is_timeout", False) else 0,
        "agent": detect_agent(),
        "trigger_type": os.environ.get("SKILL_QUALITY_TRIGGER", "manual"),
        "report_source": "report",
        "start_time": start_time,
        "end_time": end_time,
    }
    # 移除 None 值
    payload = {k: v for k, v in payload.items() if v is not None}

    ok, resp = _post_with_token(payload, token)
    if ok:
        print(f"上报成功 trace_id={trace_id}")
        return 0
    else:
        print(f"上报失败: {resp}", file=sys.stderr)
        return 1

def do_check(args):
    """自检: 验证 CLI 与 APIG 连通性"""
    if DISABLED:
        print("SKILL_QUALITY_DISABLE=1, 上报已禁用")
        return 0

    ak, sk = load_ak_sk()
    if not ak or not sk:
        print("错误: 未找到 AK/SK", file=sys.stderr)
        return 1

    print(f"AK/SK: {ak[:4]}...{ak[-4:]}")
    print(f"Endpoint: {ENDPOINT}")
    print(f"Region: {REGION}")

    try:
        token = get_iam_token(ak, sk, REGION)
        print(f"IAM Token: 获取成功 ({len(token)} chars)")
    except RuntimeError as e:
        print(f"IAM Token: 获取失败 - {e}", file=sys.stderr)
        return 1

    trace_id = _new_trace_id()
    payload = {
        "trace_id": trace_id,
        "skill_name": "__cli_self_check__",
        "skill_id": "cli",
        "skill_version": __version__,
        "status": "success",
        "trigger_type": "auto",
        "agent": detect_agent(),
        "report_source": "check",
        "start_time": _now_iso(),
        "end_time": _now_iso(),
    }

    ok, resp = _post_with_token(payload, token)
    if ok:
        print(f"自检成功! trace_id={trace_id}")
        return 0
    else:
        print(f"自检失败: {resp}", file=sys.stderr)
        return 1

def do_wrap(args):
    """wrap模式: 包裹命令执行，自动上报成功/失败"""
    if DISABLED:
        # 直接执行命令，不上报
        return subprocess.call(args.command)

    ak, sk = load_ak_sk()
    if not ak or not sk:
        print("错误: 未找到 AK/SK", file=sys.stderr)
        return 1

    try:
        token = get_iam_token(ak, sk, REGION)
    except RuntimeError as e:
        print(f"错误: {e}", file=sys.stderr)
        return 1

    trace_id = _new_trace_id()
    start_mono = time.monotonic()
    start_time = _now_iso()

    # 超时阈值: CLI参数 > 环境变量 > 无
    timeout_threshold_ms = None
    if getattr(args, "timeout_threshold_ms", None):
        timeout_threshold_ms = args.timeout_threshold_ms
    else:
        env_val = os.environ.get("SKILL_QUALITY_TIMEOUT_MS")
        if env_val:
            timeout_threshold_ms = int(env_val)

    # wrap 补全字段
    skill_id = getattr(args, "skill_id", None) or os.environ.get("SKILL_QUALITY_ID", "")
    skill_version = getattr(args, "skill_version", None) or os.environ.get("SKILL_QUALITY_VERSION", "") or "1.0.0"
    agent = detect_agent()
    trigger_type = os.environ.get("SKILL_QUALITY_TRIGGER", "auto")  # wrap 默认 auto

    # 被执行命令行作为 input_param
    cmd_str = " ".join(args.command)

    try:
        proc = subprocess.run(args.command, capture_output=True, text=True, timeout=HTTP_TIMEOUT * 10)
        cost_ms = int((time.monotonic() - start_mono) * 1000)
        end_time = _now_iso()
        stderr_output = proc.stderr or ""
        stdout_output = proc.stdout or ""

        # is_timeout 判断
        is_timeout = 1 if (timeout_threshold_ms and cost_ms > timeout_threshold_ms) else 0

        if proc.returncode == 0:
            status, error_code, error_msg = "success", None, None
        else:
            error_code = infer_error_code(stderr_output)
            status = infer_status_from_error_code(error_code)  # 根据 error_code 反推 status
            error_msg = stderr_output[:500] if stderr_output else f"exit code {proc.returncode}"

        payload = {
            "trace_id": trace_id,
            "skill_name": args.skill_name or "unknown",
            "skill_id": skill_id,
            "skill_version": skill_version,
            "status": status,
            "error_code": error_code,
            "error_msg": error_msg,
            "full_stack": stderr_output[:20000] if stderr_output else None,  # 完整 stderr
            "cost_ms": cost_ms,
            "is_timeout": is_timeout,
            "input_param": mask_text(cmd_str)[:6000],
            "output_result": mask_text(stdout_output)[:6000],
            "agent": agent,
            "trigger_type": trigger_type,
            "report_source": "wrap",
            "start_time": start_time,
            "end_time": end_time,
        }
        payload = {k: v for k, v in payload.items() if v is not None}
        _post_with_token(payload, token)
        return proc.returncode
    except subprocess.TimeoutExpired as e:
        cost_ms = int((time.monotonic() - start_mono) * 1000)
        end_time = _now_iso()
        stderr_output = (e.stderr or "") if isinstance(e.stderr, str) else ""
        error_code = infer_error_code(stderr_output, is_timeout=True)
        payload = {
            "trace_id": trace_id,
            "skill_name": args.skill_name or "unknown",
            "skill_id": skill_id,
            "skill_version": skill_version,
            "status": "sys_fail",
            "error_code": error_code,
            "error_msg": f"命令超时({HTTP_TIMEOUT * 10}s)",
            "full_stack": stderr_output[:20000] if stderr_output else None,
            "cost_ms": cost_ms,
            "is_timeout": 1,
            "agent": agent,
            "trigger_type": trigger_type,
            "report_source": "wrap",
            "start_time": start_time,
            "end_time": end_time,
        }
        payload = {k: v for k, v in payload.items() if v is not None}
        _post_with_token(payload, token)
        return 1
    except Exception as e:
        cost_ms = int((time.monotonic() - start_mono) * 1000)
        end_time = _now_iso()
        payload = {
            "trace_id": trace_id,
            "skill_name": args.skill_name or "unknown",
            "skill_id": skill_id,
            "skill_version": skill_version,
            "status": "sys_fail",
            "error_code": "B01",
            "error_msg": str(e)[:500],
            "full_stack": traceback.format_exc()[:20000],
            "cost_ms": cost_ms,
            "is_timeout": 0,
            "agent": agent,
            "trigger_type": trigger_type,
            "report_source": "wrap",
            "start_time": start_time,
            "end_time": end_time,
        }
        payload = {k: v for k, v in payload.items() if v is not None}
        _post_with_token(payload, token)
        raise

# ==================== main ====================

def main():
    parser = argparse.ArgumentParser(
        prog="skill-quality",
        description="AI Skill 执行质量上报 CLI (IAM认证, APIG公网)"
    )
    parser.add_argument("--version", action="version", version=f"skill-quality {__version__}")
    sub = parser.add_subparsers(dest="command")

    # report
    rp = sub.add_parser("report", help="上报 Skill 执行质量")
    rp.add_argument("--skill-name", required=True, help="Skill 名称")
    rp.add_argument("--skill-id", help="Skill ID")
    rp.add_argument("--skill-version", help="版本号")
    rp.add_argument("--status", required=True,
                     choices=["success", "biz_fail", "sys_fail", "cancel"],
                     help="执行状态")
    rp.add_argument("--error-code", help="错误码(U01/C01/N01/B01/P01...)")
    rp.add_argument("--error-msg", help="错误描述")
    rp.add_argument("--cost-ms", type=int, help="耗时(毫秒)")
    rp.add_argument("--input-param", help="入参(JSON字符串)")
    rp.add_argument("--output-result", help="输出(JSON字符串)")
    rp.add_argument("--full-stack", help="异常堆栈")
    rp.add_argument("--retry-times", type=int, default=None, help="重试次数")
    rp.add_argument("--is-timeout", action="store_true", help="标记为超时")
    rp.add_argument("--start-time", help="执行开始时间(ISO格式)")
    rp.add_argument("--end-time", help="执行结束时间(ISO格式)")

    # check
    sub.add_parser("check", help="自检: 验证 CLI 与 APIG 连通性")

    # wrap - 不用 argparse 解析被包裹命令，直接从 sys.argv 提取 -- 后的部分
    wp = sub.add_parser("wrap", help="包裹命令执行，自动上报成功/失败")
    wp.add_argument("--skill-name", help="Skill 名称")
    wp.add_argument("--skill-id", help="Skill ID")
    wp.add_argument("--skill-version", help="版本号")
    wp.add_argument("--timeout-threshold-ms", type=int, help="超时阈值(ms), cost_ms超过则is_timeout=1")

    # 提取 wrap 的被包裹命令（-- 之后的部分），在 argparse 之前处理
    wrap_cmd = []
    if "wrap" in sys.argv:
        try:
            sep_idx = sys.argv.index("--")
            wrap_cmd = sys.argv[sep_idx + 1:]
            # 截断 sys.argv 使 argparse 不看到 -- 之后的部分
            sys.argv = sys.argv[:sep_idx]
        except ValueError:
            pass

    args = parser.parse_args()

    if args.command == "report":
        sys.exit(do_report(args))
    elif args.command == "check":
        sys.exit(do_check(args))
    elif args.command == "wrap":
        if not wrap_cmd:
            wp.error("请指定要执行的命令（用 -- 分隔，如: skill-quality wrap --skill-name xxx -- python3 my_skill.py）")
        args.command = wrap_cmd
        sys.exit(do_wrap(args))
    else:
        parser.print_help()
        sys.exit(1)

if __name__ == "__main__":
    main()
