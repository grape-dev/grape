# =============================================================================
# skillsopr 工具链环境配置模板 (env.example)
# 复制为 ~/.agents/skills/.env 后填写真实值。
# ⚠️ 禁止留空 export(空字符串会覆盖脚本 ${VAR:-默认} 兜底, 导致 DB/token 连不上)。
# 本文件只含占位符, 不含真实凭据, 可安全入库。
# =============================================================================

# --- GitCode ---
export GITCODE_TOKEN="REPLACE_WITH_GITCODE_TOKEN"
export GITCODE_API="https://api.gitcode.com/api/v5"
export GITCODE_OWNER="REPLACE_WITH_GITCODE_OWNER"
export GITCODE_REPO="REPLACE_WITH_GITCODE_REPO"
export GITCODE_REPO_SSH="git@gitcode.com:REPLACE_WITH_OWNER/REPLACE_WITH_REPO.git"
export GITCODE_CHECKOUT="main"

# --- 数据库 ---
export DB_HOST="192.168.1.18"
export DB_USER="root"
export DB_PASS="REPLACE_WITH_DB_PASSWORD"
export DB_NAME="rds-hd-skillsopr-db"

# --- 华为云 AK/SK ---
export HUAWEICLOUD_SDK_AK="REPLACE_WITH_HW_AK"
export HUAWEICLOUD_SDK_SK="REPLACE_WITH_HW_SK"

# --- multica(可选, deploy 脚本交互式填写) ---
export MULTICA_SERVER_URL="https://multica.clouddeveloper.club"
# export MULTICA_TOKEN="mul_REPLACE_WITH_TOKEN"
# export MULTICA_WORKSPACE_ID="REPLACE_WITH_WORKSPACE_ID"
