{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grape.dev/schemas/plugin.schema.json",
  "title": "Grape Plugin Manifest (plugin.json)",
  "description": "Grape 插件市场插件清单标准（总纲 #1078 A1，Issue #1079；channels/script 型见 Issue #1311）。adapters[] 统一 cli/mcp-stdio/mcp-remote/http/script 五种 transport；compat.engines 强声明（D7：cli/http/script 全 6 引擎，mcp 初限 codex）；credentials 声明凭据与注入位（D6）；commands 统一命令面（同一命令可多 adapter 实现，channels 声明通道优先级供 failover）；permissions 声明出网域名与 exec 白名单；bundled_skills 声明随插件分发的技能（D1）。",
  "type": "object",
  "required": ["name", "version", "adapters", "commands"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "description": "插件唯一名：小写字母/数字/连字符，1-63 字符"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "description": "语义化版本 semver"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "compat": { "$ref": "#/$defs/compat" },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/adapter" }
    },
    "credentials": {
      "type": "object",
      "description": "凭据声明表：键为凭据名，供 adapter.auth.credential 引用（D6：仅声明，不做凭据库实现）",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/credential" }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/command" }
    },
    "permissions": {
      "type": "object",
      "description": "权限声明（L0 仅声明；L1/L2 运行时强制）",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$" },
          "description": "出网域名白名单（支持 *.example.com 通配）"
        },
        "exec": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "exec 白名单：插件适配器允许执行的可执行文件名"
        }
      }
    },
    "bundled_skills": {
      "type": "array",
      "description": "随插件分发的技能（D1）",
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
          "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$", "description": "插件包内相对路径：每段以字母/数字开头（禁止绝对路径、.. 穿越段、盘符与反斜杠）" }
        }
      }
    }
  },
  "$defs": {
    "compat": {
      "type": "object",
      "required": ["engines"],
      "additionalProperties": false,
      "properties": {
        "engines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["opencode", "codearts", "hermes", "codex", "dsh", "hwcloud"]
          }
        }
      }
    },
    "adapter": {
      "type": "object",
      "required": ["id", "transport", "compat"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
        "transport": {
          "type": "string",
          "enum": ["cli", "mcp-stdio", "mcp-remote", "http", "script"]
        },
        "command": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "cli/mcp-stdio：可执行文件名（禁止路径分隔符与穿越）"
        },
        "script": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$",
          "description": "script：签名脚本相对路径（限插件目录内，禁绝对路径、.. 穿越段、盘符与反斜杠；Issue #1311 第五型通道）"
        },
        "via": {
          "type": "string",
          "enum": ["http"],
          "description": "script：脚本产物交付的传输通道（当前仅 http）"
        },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "url": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.:/_%~#?=&+\\-@\\[\\]]+$",
          "description": "mcp-remote/http：仅允许 https 远端端点"
        },
        "compat": { "$ref": "#/$defs/compat" },
        "auth": {
          "type": "object",
          "description": "凭据声明 + 注入位（credential 必须引用 credentials 表键名）",
          "required": ["credential", "inject"],
          "additionalProperties": false,
          "properties": {
            "credential": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "inject": { "type": "string", "enum": ["env", "header", "query", "argv"] },
            "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "header": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
            "template": { "type": "string", "description": "header/argv 注入模板，如 \"Bearer {credential}\"" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "transport": { "const": "cli" } } },
          "then": { "required": ["command"] }
        },
        {
          "if": { "properties": { "transport": { "const": "mcp-stdio" } } },
          "then": { "required": ["command"] }
        },
        {
          "if": { "properties": { "transport": { "const": "mcp-remote" } } },
          "then": { "required": ["url"] }
        },
        {
          "if": { "properties": { "transport": { "const": "http" } } },
          "then": { "required": ["url"] }
        },
        {
          "if": { "properties": { "transport": { "const": "script" } } },
          "then": { "required": ["script", "url"] }
        },
        {
          "if": { "properties": { "transport": { "enum": ["cli", "http", "script"] } } },
          "then": {
            "properties": {
              "compat": {
                "properties": {
                  "engines": { "minItems": 6 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "transport": { "enum": ["mcp-stdio", "mcp-remote"] } } },
          "then": {
            "properties": {
              "compat": {
                "properties": {
                  "engines": {
                    "items": { "const": "codex" }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "credential": {
      "type": "object",
      "required": ["required", "inject"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "inject": { "type": "string", "enum": ["env", "header", "query", "argv"] },
        "scope": { "type": "string", "enum": ["user", "repo", "org"] },
        "expiry": { "type": "string", "enum": ["session", "persistent"] },
        "description": { "type": "string" }
      }
    },
    "command": {
      "type": "object",
      "required": ["name", "adapters"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$" },
        "description": { "type": "string", "maxLength": 1000 },
        "adapters": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
          "description": "该命令的 adapter 实现列表（同一命令可多 adapter 实现）"
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
          "description": "该命令的通道优先级声明（降序，failover 按此序逐通道 try；Issue #1311。未声明时 adapters 列表顺序即通道序，旧单 adapter 写法等价单通道）"
        },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,62}$" },
              "type": { "type": "string", "enum": ["string", "number", "boolean", "object", "array"] },
              "required": { "type": "boolean" },
              "default": {},
              "description": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
