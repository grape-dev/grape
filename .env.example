# .env.example —— 复制为 .env 后填写实际值
# .env 不提交到 git（已在 .gitignore）
#
# 本地开发默认使用 SQLite，无需 MySQL/OBS。
# 生产环境请取消注释并填写实际值。

# ===== 数据库 =====
# 本地开发：SQLite（默认，零配置）
DEVOPS_DB_BACKEND=sqlite

# 生产环境：取消注释并配置 MySQL
#DEVOPS_DB_BACKEND=mysql
#DEVOPS_DB_HOST=127.0.0.1
#DEVOPS_DB_PORT=3306
#DEVOPS_DB_USER=grape
#DEVOPS_DB_PASSWORD=your-db-password
#DEVOPS_DB_NAME=rds-grape-dev

# ===== OBS 对象存储（可选） =====
# 本地开发默认关闭；生产环境取消注释并填写实际值
OBS_ENABLED=false
#OBS_BUCKET=obs-grape-dev-file
#OBS_ACCESS_KEY=your-access-key
#OBS_SECRET_KEY=your-secret-key
#OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
#OBS_PREFIX=grape/prod

# ===== JWT 会话共享 =====
# 所有实例必须配同一个 secret
# 生产环境必须改为随机字符串（不少于 32 字符）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-jwt-secret-change-in-production

# ===== Cookie 安全 =====
# 生产 HTTPS 默认 true，开发 HTTP 配 false
COOKIE_SECURE=false

# ===== 公网 IP 自动探测（可选） =====
# 本地开发 / 内网环境设为 false 可跳过约 40s 的公网 IP 探测
GRAPE_AUTO_DETECT_URL=false

# ===== 知识库内存缓存最大条数（默认 1000） =====
KNOWLEDGE_CACHE_MAX=1000

# ===== 知识正文大小上限（字节，不设置则默认 5242880=5MB；非数字回退默认值，低于 1024 钳制为 1024） =====
#KNOWLEDGE_MAX_CONTENT_BYTES=5242880
