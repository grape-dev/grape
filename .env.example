# .env.example —— 复制为 .env 后填写实际值
# .env 不提交到 git（已在 .gitignore）
#
# 本地开发默认使用 SQLite，无需 MySQL/OBS。
# 生产环境请取消注释并填写实际值。

# ===== 数据库 =====
# 本地开发：SQLite（默认，零配置）
DEVOPS_DB_BACKEND=sqlite

# 生产环境：取消注释并配置 MySQL
#DEVOPS_DB_BACKEND=mysql
#DEVOPS_DB_HOST=127.0.0.1
#DEVOPS_DB_PORT=3306
#DEVOPS_DB_USER=grape
#DEVOPS_DB_PASSWORD=your-db-password
#DEVOPS_DB_NAME=rds-grape-dev

# ===== OBS 对象存储（可选） =====
# 本地开发默认关闭；生产环境取消注释并填写实际值
OBS_ENABLED=false
#OBS_BUCKET=obs-grape-dev-file
#OBS_ACCESS_KEY=your-access-key
#OBS_SECRET_KEY=your-secret-key
#OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
#OBS_PREFIX=grape/prod

# ===== JWT 会话共享 =====
# 所有实例必须配同一个 secret
# 生产环境必须改为随机字符串（不少于 32 字符）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-jwt-secret-change-in-production

# ===== Cookie 安全 =====
# 生产 HTTPS 默认 true，开发 HTTP 配 false
COOKIE_SECURE=false

# ===== 公网 IP 自动探测（可选） =====
# 本地开发 / 内网环境设为 false 可跳过约 40s 的公网 IP 探测
GRAPE_AUTO_DETECT_URL=false

# ===== 知识库内存缓存最大条数（默认 1000） =====
KNOWLEDGE_CACHE_MAX=1000

# ===== 知识正文大小上限（字节，不设置则默认 5242880=5MB；非数字回退默认值，低于 1024 钳制为 1024） =====
#KNOWLEDGE_MAX_CONTENT_BYTES=5242880

# ===== 本机业务 API 端口（Issue #1731，可选） =====
# 单机多进程部署时 runtime 端口（如 8083）与业务 API 端口（如 8081）分离，
# 本机 runtime 分支探测业务端点时用本端口。优先级：
# server-config.json/task_business_api_port > 本变量 > GRAPE_PORT > GRAPE_MAIN_PORT > 3000
#GRAPE_BUSINESS_PORT=8081

# ===== 业务 API 探测（Issue #1731，可选） =====
# 候选基址可用性探测的整体超时（秒）与进程内结果缓存 TTL（秒）。
# 取值依据：单机回环 health+openapi 实测 P99 12~40ms，1s 为 ~25 倍余量；
# 60s 与其它事件级缓存同量级，端口修好后一分钟内自愈。负结果同样缓存 60s。
#GRAPE_BUSINESS_API_PROBE_TIMEOUT=1
#GRAPE_BUSINESS_API_PROBE_TTL=60

# ===== 场景技能 scope 判定降级开关（Issue #1758，可选） =====
# deny（默认）= 技能 scope 查询异常时按 fail-closed 拒绝（保存 400 / 派发 fail-fast）；
# allow = 查询异常时按放行处理，日志打 warning 且判定结果 source=db_error。
# 仅在 DB 抖动导致整仓派发被阻断时临时打开；打开期间 user 级技能可能被误放行。
#GRAPE_SCENE_SCOPE_ON_ERROR=deny

# ===== 插件市场前端入口开关（Issue #3395，可选） =====
# 1（默认）= 展示侧边栏「插件市场」/场景·技能页插件 Tab/chat 插件选择器/
#             Runtime 详情插件面板/#plugins 深链；
# 0 = 隐藏以上全部前端入口（不渲染）。后端 /api/plugins* 与插件、凭据数据一律保留。
#GRAPE_FEATURE_PLUGINS=1
# ===== worker 僵尸任务兜底回收（Issue #124，可选） =====
# 每轮巡检把「服务端已终态、本地却还挂着」的任务摘掉并杀残留引擎；阈值默认 30 分钟。
# 非终态的超龄任务不会被强制失败（健康长任务上限 2h），只由代次比对/看门狗处理。
#RUNTIME_ZOMBIE_TASK_THRESHOLD=1800
# ===== A2A 终态载体派发守卫（Issue #2816，可选） =====
# 命中 needs-human 标签或载体 PR 的 needs-human-terminal 标记行时，派发 coding 前短路。
# 默认开启（1）；置 0 关闭整守卫。TTL=判定缓存秒数；TIMEOUT=单次 VCS 请求超时秒数；
# BUDGET=单次取数总预算秒数（覆盖多次请求，防止逐个累加）。
# PAGES/PRS=单次判定的评论页与载体 PR 上界；CACHE=判定缓存条数上限（约 2.8KB/条）。
#A2A_TERMINAL_GUARD=1
#A2A_TERMINAL_GUARD_TTL=60
#A2A_TERMINAL_GUARD_TIMEOUT=5
#A2A_TERMINAL_GUARD_BUDGET=20
#A2A_TERMINAL_GUARD_MAX_COMMENT_PAGES=2
#A2A_TERMINAL_GUARD_MAX_CARRIER_PRS=2
#A2A_TERMINAL_GUARD_MAX_CACHE=2048

# ===== 流水线标题兜底（Issue #2925，可选） =====
# GET /api/pipeline 只对当前页窗口内的占位标题做有界兜底。
# CONCURRENCY=并发（1~16，默认 8）：97 条在 4s 内跑完取最小值，上游限流时下调。
# DEADLINE=单请求总预算秒（0.5~30，默认 4.0）：spec 要求冷请求 ≤5s，留 1s 组装响应。
# TIMEOUT=单请求超时秒（0.5~30，默认 3.5）：须小于 DEADLINE；实测单次详情 0.44s。
# NEG_CACHE_TTL=已尝试标记有效期秒（默认 21600=6h，0=永久）：量级默认值，未经实测；
# 上游改标题后超过该时长才会重试，需要更快回补就下调。
#GRAPE_PIPELINE_TITLE_FETCH_CONCURRENCY=8
#GRAPE_PIPELINE_TITLE_FETCH_DEADLINE=4.0
#GRAPE_PIPELINE_TITLE_FETCH_TIMEOUT=3.5
#GRAPE_PIPELINE_TITLE_NEG_CACHE_TTL=21600

# ===== 失败日志出口与基线失败打点（Issue #4023，可选） =====
# 非基线异常的 Task failed 日志/失败原因上限（下限 400），超限追加「…(truncated N chars)」；
# 基线异常（workspace baseline mismatch）固定七要素、不受该上限约束。
#GRAPE_FAILURE_LOG_LIMIT=500
# 同 issue 同 reason 连续失败达阈值（下限 1）→ ERROR 打点 baseline_mismatch_repeat；
# 打点为单进程内计数，跨进程聚合由日志采集侧完成。
#GRAPE_BASELINE_REPEAT_THRESHOLD=3
# 连续失败链的时间窗口秒（下限 1.0），超窗或 reason 变化即重置计数。
#GRAPE_BASELINE_REPEAT_WINDOW_SECONDS=3600
