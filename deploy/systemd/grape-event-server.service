# Grape Event Server（Event 进程 :38082）— Issue #699 Phase 4 四进程拆分
# [端口已对齐事实源 Issue #3764] 本单元端口与 scripts/deploy_preflight.py::UPSTREAM_ROLE_PORT
# 一致（mgmt/event/worker/insight = 38081/38082/38083/38084）；新部署推荐
# scripts/install-grape-systemd.sh 的 grape@.service 模板路径。
[Unit]
Description=Grape Event Server (Webhook + Event Pipeline)
After=network.target grape-server.service

[Service]
User=grape
WorkingDirectory=/opt/grape
Environment=PYTHONUNBUFFERED=1
Environment=GRAPE_PROCESS_ROLE=event
Environment=GRAPE_PORT=38082
EnvironmentFile=/etc/grape/grape.env
ExecStart=/opt/grape/.venv/bin/uvicorn src.api.grape_event_server:app \
    --host 0.0.0.0 --port 38082 --workers 1
Restart=always
RestartSec=5
# Issue #3847：优雅退出——SIGTERM 先让 uvicorn 排空在途请求，45s 后仍未退出才强杀。
# 与 nginx 的 worker_shutdown_timeout 30s 对齐（systemd 多留 15s 余量）。
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
