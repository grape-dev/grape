# Grape Insight Server（Insight 进程 :38083）— Issue #699 Phase 4 四进程拆分
# [DEPRECATED 端口布局] 本单元为 38080-38083 历史四进程口径（Issue #3764）；
# 现行单一端口事实源 = scripts/deploy_preflight.py::UPSTREAM_ROLE_PORT
# （mgmt/event/worker/insight = 38081/38082/38083/38084，见 scripts/install-grape-systemd.sh）。
[Unit]
Description=Grape Insight Server (Observability + Dashboard + SLO)
After=network.target grape-server.service

[Service]
User=grape
WorkingDirectory=/opt/grape
Environment=PYTHONUNBUFFERED=1
Environment=GRAPE_PROCESS_ROLE=insight
Environment=GRAPE_PORT=38083
Environment=OBS_LOG_DB=1
EnvironmentFile=/etc/grape/grape.env
ExecStart=/opt/grape/.venv/bin/uvicorn src.api.grape_insight_server:app \
    --host 0.0.0.0 --port 38083 --workers 1
Restart=always
RestartSec=5
# Issue #3847：优雅退出——SIGTERM 先让 uvicorn 排空在途请求，45s 后仍未退出才强杀。
# 与 nginx 的 worker_shutdown_timeout 30s 对齐（systemd 多留 15s 余量）。
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
