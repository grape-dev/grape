  {
   "id": 30,
   "type": "stat",
   "title": "错误预算剩余（99% · 7d）",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * (1 - (sum(increase(grape_http_requests_total{env=~\"$env\",status=~\"5..\",route!=\"/faro/collect\"}[7d])) / scalar(sum(increase(grape_http_requests_total{env=~\"$env\"}[7d])) * 0.01)))",
     "refId": "A",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "auto",
    "textMode": "auto",
    "wideLayout": true
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "decimals": 1,
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 20
       },
       {
        "color": "green",
        "value": 50
       }
      ]
     }
    },
    "overrides": []
   },
   "description": "SLO 目标 99%（与 src/domains/insight/observability/slo.py 的默认 target 一致），7 天滚动窗口。注意：环境新接入时 Prometheus 只有几小时数据，increase 会按现有数据估算，此时这一格接近「自接入以来」的口径"
  },
