{
 "uid": "grape-entry-slo",
 "title": "Grape 入口与 SLO",
 "tags": [
  "grape",
  "slo",
  "entry"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "editable": true,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "env",
    "label": "环境",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(up{job=~\"grape-.*\"}, env)",
    "refresh": 2,
    "multi": false,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "host",
    "label": "节点",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(up{job=~\"grape-.+-node\"}, host)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "role",
    "label": "进程角色",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(grape_http_requests_total{env=~\"$env\"}, role)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "Annotations & Alerts",
    "type": "dashboard",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "iconColor": "rgba(0,211,262,1)"
   }
  ]
 },
 "panels": [
  {
   "id": 25,
   "type": "row",
   "title": "① 用户视角：入口还好吗",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 26,
   "type": "stat",
   "title": "入口 QPS",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(grape_http_requests_total{env=~\"$env\",host=~\"$host\",role=~\"$role\"}[5m]))",
     "refId": "A",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "auto",
    "textMode": "auto",
    "wideLayout": true
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "decimals": 2,
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
