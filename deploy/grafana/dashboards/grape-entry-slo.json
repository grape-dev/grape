     "expr": "100 * (sum(rate(grape_http_requests_total{env=~\"$env\",status=~\"5..\",route!=\"/faro/collect\"}[5m])) or vector(0)) / scalar(sum(rate(grape_http_requests_total{env=~\"$env\"}[5m])))",
