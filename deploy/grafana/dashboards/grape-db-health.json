   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "60 * max(rate(grape_db_aborted_connects_total{env=~\"$env\"}[10m]))",
     "refId": "A",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
