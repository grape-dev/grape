    "wideLayout": true
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "decimals": 1,
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
