{
 "uid": "grape-db-health",
 "title": "Grape 数据库连接健康",
 "tags": [
  "grape",
  "mysql",
  "db"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "editable": true,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "env",
    "label": "环境",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(up{job=~\"grape-.*\"}, env)",
    "refresh": 2,
    "multi": false,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "host",
    "label": "节点",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(up{job=~\"grape-.+-node\"}, host)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "role",
    "label": "进程角色",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(grape_http_requests_total{env=~\"$env\"}, role)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "Annotations & Alerts",
    "type": "dashboard",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "iconColor": "rgba(0,211,262,1)"
   }
  ]
 },
 "panels": [
  {
   "id": 46,
   "type": "row",
   "title": "① 连接与异常（MySQL 全局计数，已去重）",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 47,
   "type": "stat",
   "title": "连接总数",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(grape_db_threads_connected{env=~\"$env\"})",
     "refId": "A",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "auto",
    "textMode": "auto",
    "wideLayout": true
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "decimals": 0
    },
    "overrides": []
   },
   "description": "max 去重：同一份 MySQL 全局值被多个进程各报一遍，不能用 sum"
  },
  {
   "id": 48,
   "type": "stat",
   "title": "活跃连接占比",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * max(grape_db_threads_running{env=~\"$env\"}) / scalar(max(grape_db_threads_connected{env=~\"$env\"}))",
     "refId": "A",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
