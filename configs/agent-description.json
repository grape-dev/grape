{
  "vod": {
    "name": "VOD Agent",
    "icon": "🔍",
    "color": "var(--pk)",
    "bg": "#fde8f0",
    "description": "从开发者声音中收集反馈、聚类分析共性、提炼价值、自动创建 Issue",
    "backend": "opencode",
    "order_num": 1,
    "subscribe_events": [
      "vod_signal",
      "issue_opened",
      "issue_updated",
      "issue_comment"
    ],
    "enable": true
  },
  "issue": {
    "name": "Issue Agent",
    "icon": "📋",
    "color": "var(--r)",
    "bg": "#fce5e5",
    "description": "Issue 分类、标签、指派、A2A 触发 Coding Agent",
    "backend": "opencode",
    "order_num": 2,
    "subscribe_events": [
      "issue_updated",
      "issue_labeled",
      "issue_comment"
    ],
    "enable": true
  },
  "coding": {
    "name": "Coding Agent",
    "icon": "💻",
    "color": "var(--a)",
    "bg": "#e3edfd",
    "description": "代码实现、PR 创建、自我审查（通过 A2A 由 Issue/QA Agent 触发，不直接感知 PR 事件）",
    "backend": "opencode",
    "order_num": 3,
    "subscribe_events": [],
    "enable": true
  },
  "qa": {
    "name": "QA Agent",
    "icon": "🧪",
    "color": "var(--pu)",
    "bg": "#f3e9fe",
    "description": "代码审查、自动化测试、功能验证、安全检查（由 Coding Agent 通过 A2A 事件触发审查，不直接监听 PR 事件）",
    "backend": "opencode",
    "order_num": 4,
    "subscribe_events": [
      "pull_request_opened",
      "pull_request_updated",
      "note_hook_pr"
    ],
    "enable": true
  },
  "sre": {
    "name": "SRE Agent",
    "icon": "⚙️",
    "color": "var(--or)",
    "bg": "#fef0e4",
    "description": "构建部署、发布管理、监控运维、故障排查",
    "backend": "opencode",
    "order_num": 5,
    "subscribe_events": [
      "pull_request_merged",
      "build_failure",
      "deploy_start",
      "deploy_failure",
      "release_created"
    ],
    "enable": false
  }
}