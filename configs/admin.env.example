# admin 运营管理台数据库配置（admin-db-split v1.0：双数据源）
#   ADMIN_DB_* → grape_admin_db（admin 管理台自有表）
#   GRAPE_DB_* → rds-grape-dev（grape 业务表）
# 使用方法：复制此文件为 configs/admin.env，填入真实值
ADMIN_DB_URL=jdbc:mysql://<host>:<port>/grape_admin_db?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=utf8
ADMIN_DB_USER=
ADMIN_DB_PASSWORD=
GRAPE_DB_URL=jdbc:mysql://<host>:<port>/grape-dev-db?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=utf8
GRAPE_DB_USER=
GRAPE_DB_PASSWORD=
ADMIN_JWT_SECRET=
ADMIN_SEED_PASSWORD=
HERMES_BIN=/usr/local/bin/hermes
# 独立库后恢复 Flyway（基线方式 baseline-version=16，V1-V16 不重放）
SPRING_FLYWAY_ENABLED=true
